# Copy to .env and fill in real values: cp .env.example .env
# (.env is gitignored; this file is the committed template.)

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# AWS / S3 Configuration (Spark job: read/write access to the bucket)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_BUCKET=your-bucket-name
AWS_REGION=us-east-2

# Grafana (separate read-only IAM user, see grafana/iam/grafana-athena-reader-policy.json)
GRAFANA_AWS_ACCESS_KEY_ID=...
GRAFANA_AWS_SECRET_ACCESS_KEY=...
ATHENA_OUTPUT_LOCATION=s3://your-bucket-name/athena-results/grafana/
GRAFANA_ADMIN_PASSWORD=...
