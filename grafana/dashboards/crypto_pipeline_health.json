            "uid": "athena"
          },
          "format": 0,
          "rawSQL": "SELECT window_start AS time, vwap, high, low\nFROM streaming_gold_trades\nWHERE dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd')\n  AND symbol = 'BTC-USD'\n  AND $__timeFilter(window_start)\nORDER BY time",
          "connectionArgs": {
