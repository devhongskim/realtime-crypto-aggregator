{
  "uid": "crypto-pipeline-health",
  "title": "Crypto Streaming Pipeline: Health",
  "description": "Pipeline observability for the Coinbase -> Kafka -> Spark -> S3 streaming job, queried live from Athena (streaming_gold_trades).",
  "tags": [
    "crypto",
    "streaming",
    "athena"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Seconds since last Gold write",
      "description": "Freshness check: how long ago Spark last committed a finalized window to S3. Normally under ~60s (10s window + 30s watermark + 10s trigger). Red means the job has stalled or stopped.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 1,
          "rawSQL": "SELECT CAST(to_unixtime(current_timestamp) - to_unixtime(max(written_at)) AS BIGINT) AS seconds_since_last_write\nFROM streaming_gold_trades\nWHERE dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd')",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Windows written (time range)",
      "description": "Count of finalized 10-second windows (all symbols) written in the selected time range.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 1,
          "rawSQL": "SELECT count(*) AS windows_written\nFROM streaming_gold_trades\nWHERE dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd')\n  AND $__timeFilter(window_start)",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Median end-to-end latency (time range)",
      "description": "Median time from a window closing (window_end) to its row being written to S3 (written_at). Dominated by the 30s watermark by design (ADR-004).",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 1,
          "rawSQL": "SELECT approx_percentile(date_diff('millisecond', window_end, written_at) / 1000.0, 0.5) AS median_latency_s\nFROM streaming_gold_trades\nWHERE dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd')\n  AND $__timeFilter(window_start)",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "End-to-end latency: window close -> S3 write",
      "description": "Seconds between each window's end and its Gold row being written. A steady band around 30-50s is the watermark (30s) plus trigger interval (10s) working as designed; spikes indicate backpressure or slow S3 commits.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 0,
          "rawSQL": "SELECT window_end AS time, symbol,\n       date_diff('millisecond', window_end, written_at) / 1000.0 AS latency_s\nFROM streaming_gold_trades\nWHERE dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd')\n  AND $__timeFilter(window_end)\nORDER BY time",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Windows per minute (completeness)",
      "description": "Finalized windows per minute per symbol. A healthy, continuously-trading symbol produces 6 (one per 10s window); dips mean windows with zero trades or pipeline downtime.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short",
          "max": 7,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 0,
          "rawSQL": "SELECT $__timeGroup(window_start, '1m') AS time, symbol, count(*) AS windows\nFROM streaming_gold_trades\nWHERE dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd')\n  AND $__timeFilter(window_start)\nGROUP BY 1, 2\nORDER BY 1",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Trades per 10s window",
      "description": "trade_count per window and symbol: raw ingestion throughput as seen after validation and dedup.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 0,
          "rawSQL": "SELECT window_start AS time, symbol, trade_count\nFROM streaming_gold_trades\nWHERE dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd')\n  AND $__timeFilter(window_start)\nORDER BY time",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "BTC-USD: VWAP with high/low per window",
      "description": "Correctness check, not a trading signal: VWAP should always sit between each window's low and high.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
